    {
      "id": "f-001",
      "rule_id": "TA-001",
      "title": "A person and an AI agent share shared-ops-role",
      "severity": "critical",
      "description": "Jordan Ruiz and an unattributed Python agent both assumed shared-ops-role within 11 minutes. CloudTrail records the same role for both, so you cannot prove which one took an action without extra signals.",
      "actor_ids": [
        "h-jordan",
        "a-unattributed"
      ],
      "event_ids": [
        "evt-0013",
        "evt-0016"
